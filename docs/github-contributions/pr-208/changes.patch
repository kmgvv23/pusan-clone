nana_agent와 kana_agent는 하위 agent를 전역에 한 번만 만들고 재사용하며,
supervisor가 넘긴 query를 실행해 answer와 trace, 호출된 tool 이름을 JSON으로 돌려준다.
supervisor는 하위 trace를 직접 볼 수 없으므로 kana_agent는 trace를 훑어
최종 시간 결정 결과를 final_slot_payload로 끌어올려 함께 전달한다.
---
 .../week06_kanamate_decides_schedule.py       | 67 +++++++++++++++----
 1 file changed, 55 insertions(+), 12 deletions(-)

diff --git a/student_parts/week06_kanamate_decides_schedule.py b/student_parts/week06_kanamate_decides_schedule.py
index cfdb53c..65f1cb5 100644
--- a/student_parts/week06_kanamate_decides_schedule.py
+++ b/student_parts/week06_kanamate_decides_schedule.py
@@ -510,24 +510,67 @@ def propose_group_schedule(
 def nana_agent(query: str) -> str:
     """개인 일정과 개인 RAG 작업을 프롬프트 기반 Nana 하위 에이전트에게 위임합니다."""
 
-    # TODO: Week 4 도구를 가진 Nana 하위 agent를 실행하고 answer/trace/inner_tool_names를 반환하세요.
-    #   - _NANA_SUBAGENT가 None일 때만 create_agent(model=chat_model(), tools=week04_tools(),
-    #     system_prompt=nana_system_prompt())로 만들고 이후에는 재사용합니다.
-    #   - query를 user 메시지로 invoke하고, extract_agent_events(...)와 extract_final_text(...)로
-    #     trace와 answer를 뽑습니다.
-    #   - selected_agent, answer, trace, inner_tool_names를 담은 JSON 문자열을 반환합니다.
-    ...
+    global _NANA_SUBAGENT
+    if _NANA_SUBAGENT is None:
+        _NANA_SUBAGENT = create_agent(
+            model=chat_model(),
+            tools=week04_tools(),
+            system_prompt=nana_system_prompt(),
+        )
+
+    result = _NANA_SUBAGENT.invoke({"messages": [{"role": "user", "content": query}]})
+    events = extract_agent_events(result)
+    return json.dumps(
+        {
+            "ok": True,
+            "selected_agent": "nana_agent",
+            "answer": extract_final_text(result),
